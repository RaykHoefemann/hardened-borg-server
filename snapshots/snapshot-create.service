[Unit]
Description=Run 70-create-snapshot.sh (docs/SNAPSHOTS.md)

[Service]
Type=oneshot
# Generated by snapshots/71-timer-install.sh from this checkout's own
# REPO_ROOT — do not edit this path by hand, it is rewritten on every
# install run.
ExecStart=@@SCRIPT@@

# No Restart= here, deliberately: this is a oneshot triggered by
# snapshot-create.timer, not a long-running daemon. A failed run is visible
# in `systemctl --user status snapshot-create.service` / the journal and
# simply waits for the next scheduled firing — a restart loop would just
# retry the same failure (disk full, sudo misconfigured, ...) faster than
# the operator could notice it. 70-create-snapshot.sh's own exit status
# (0 only if every client succeeded) is what this reflects.
