[Unit]
Description=Run 20-check-repos.sh (docs/OPERATIONS.md)

[Service]
Type=oneshot
# Generated by scripts/21-check-timer-install.sh from this checkout's own
# REPO_ROOT -- do not edit this path by hand, it is rewritten on every
# install run.
ExecStart=@@SCRIPT@@

# Deprioritise the wrapper. The borg process itself is niced inside the
# `podman exec` by 20-check-repos.sh (CHECK_NICE); this covers the script and
# podman client around it. A weekly, off-peak OnCalendar is the real answer to
# not colliding with backup windows -- see check-repos.timer and
# 20-check-repos.sh's header.
Nice=19

# No Restart= here, deliberately: this is a oneshot triggered by
# check-repos.timer, not a long-running daemon. A failed run is visible in
# `systemctl --user status` / the journal and simply waits for the next
# scheduled firing -- a restart loop would just retry the same failure (the
# container down, a genuinely corrupt repository) faster than the operator
# could notice it. 20-check-repos.sh's own exit status (0 only if every
# repository came back clean) is what this reflects.
